# Публичные значения для фронтенда (Supabase → Project Settings → API Keys)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ТОЛЬКО для локального запуска scripts/seed.ts. Не коммитить, не добавлять в Vercel/Netlify.
# Удобнее положить в .env.seed.local
# SUPABASE_SECRET_KEY=sb_secret_...
